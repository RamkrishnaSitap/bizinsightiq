# BizInsightIQ Environment Configuration Template
# Copy to .env and customize for local deployment

# --- General Application Settings ---
APP_NAME=BizInsightIQ
APP_ENV=development
LOG_LEVEL=INFO

# --- Streamlit Dashboard Settings ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# --- Python FastAPI ML Microservice (Target Phase 3) ---
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_RELOAD=true
FASTAPI_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Java Spring Boot Backend Service (Target Phase 3) ---
SPRING_SERVER_PORT=8080
SPRING_FASTAPI_BASE_URL=http://localhost:8000/api/v1

# --- Next.js Frontend Service (Target Phase 4) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
PORT=3000

# --- PostgreSQL Database (Target Phase 4) ---
# NOTE: Do NOT commit actual database passwords or production credentials
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bizinsightiq_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
