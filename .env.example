# ==============================================================================
# BizInsightIQ Environment Configuration Template
# Copy this file to .env and replace placeholder values with your secure secrets.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=bizinsightiq_db
POSTGRES_USER=bizinsight_user
POSTGRES_PASSWORD=replace_with_a_strong_password_in_production
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# JDBC Connection URL for Spring Boot (Phase 3)
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/bizinsightiq_db
SPRING_DATASOURCE_USERNAME=bizinsight_user
SPRING_DATASOURCE_PASSWORD=replace_with_a_strong_password_in_production

# Python / SQLAlchemy Connection URL (Read-only analytical queries)
DATABASE_URL=postgresql://bizinsight_user:replace_with_a_strong_password_in_production@127.0.0.1:5432/bizinsightiq_db

# ------------------------------------------------------------------------------
# FastAPI Microservice Configuration (Phase 1)
# ------------------------------------------------------------------------------
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# Storage Configuration
# ------------------------------------------------------------------------------
DATASET_STORAGE_DIR=data/uploads
MODEL_ARTIFACT_DIR=models/artifacts
